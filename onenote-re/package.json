{
  "name": "onenote-re",
  "private": true,
  "type": "module",
  "scripts": {
    "parse": "node parser/src/cli.ts",
    "smoke": "node parser/src/smoke.ts",
    "test": "node --test canvas/viewport.test.ts parser/src/cache.test.ts parser/src/ink.test.ts parser/src/notebook.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:demo": "esbuild canvas/demo/main.tsx --bundle --minify --format=iife --jsx=automatic --outfile=canvas/demo/app.js",
    "demo": "npm run build:demo && python3 -m http.server 5180 --bind 127.0.0.1 --directory canvas/demo"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3"
  }
}
