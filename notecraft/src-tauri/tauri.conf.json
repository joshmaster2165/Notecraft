{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notecraft",
  "version": "0.3.0",
  "identifier": "app.notecraft.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5190",
    "beforeDevCommand": "npm run build:sidecar && npm run dev",
    "beforeBuildCommand": "npm run build:sidecar && npm run build:wasm && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Notecraft",
        "width": 1360,
        "height": 880,
        "minWidth": 820,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "backgroundColor": "#f5f4f0"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A local-first notebook with OneNote's features",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "externalBin": [
      "binaries/notecraft"
    ],
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  }
}
