{
  "name": "notecraft",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5191",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test src/model/ops.test.ts src/model/versions.test.ts src/model/notebookImport.test.ts src/store/diskSync.test.ts",
    "desktop": "tauri dev",
    "dist": "tauri build",
    "build:sidecar": "node scripts/sidecar.mjs",
    "tauri": "tauri",
    "desktop:build": "tauri build",
    "test:rust": "cargo test -p notecraft-core -p notecraft-cli -p onenote-re",
    "build:wasm": "cargo build -p onenote-re --lib --release --target wasm32-unknown-unknown --features wasm && wasm-bindgen --target web --out-dir src/wasm/onenote_re ../target/wasm32-unknown-unknown/release/onenote_re.wasm"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.3",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "immer": "10.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  },
  "description": "Local-first, OneNote-style notebook app",
  "author": {
    "name": "joshmaster2165",
    "email": "35616004+joshmaster2165@users.noreply.github.com"
  },
  "homepage": "https://github.com/joshmaster2165/Notecraft"
}
